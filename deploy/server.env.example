# Template of ~/projects/pisondev-platform/.env on the VPS (mode 600, never in git).
# deploy/install.sh writes it once; later changes are made on the server, followed by
#   docker compose up -d --force-recreate api web

# Stack
WEB_PORT=3040                       # loopback port nginx proxies to
APP_UID=1007                        # user_pison, owner of the release files
APP_GID=1007
POSTGRES_USER=pisondev
POSTGRES_DB=pisondev
POSTGRES_PASSWORD=                  # random hex, generated by install.sh

# API (see services/api/.env.example for every variable)
APP_ENV=production
PUBLIC_BASE_URL=https://assistant.pisondev.com
AUTH_ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_SECURE=true
AUTH_DEV_LOGIN=false
NOTION_TOKEN=
NOTION_TRANSACTIONS_DB=
NOTION_SUBSCRIPTIONS_DB=
NOTION_WEEKS_DB=
NOTION_WEBHOOK_TOKEN=
# Short host. LINKS_HOME_URL empty: the bare host shows a not-found page.
LINKS_BASE_URL=https://go.pisondev.com
LINKS_HOME_URL=
LINKS_PORT=3042
SYNC_MODE=full
SYNC_INTERVAL=60s
