# Copy to .env and fill in. .env is git-ignored; never commit real values.

APP_ENV=development                 # development or production
HTTP_ADDR=:8100
PUBLIC_BASE_URL=http://localhost:3100   # origin the browser uses; OAuth redirect and CSRF check derive from it
DATABASE_URL=postgres://pisondev:pisondev@localhost:5448/pisondev?sslmode=disable

# Access. First address is the main account, the rest are backups. Everyone else is refused.
AUTH_ALLOWED_EMAILS=main@example.com,backup@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_TTL=720h
COOKIE_SECURE=false                 # forced true in production
COOKIE_DOMAIN=                      # empty: host-only. Later ".pisondev.com" to share sign-in across subdomains
AUTH_DEV_LOGIN=false                # development only: sign in an allowed email without Google

# Notion integration "pisondev-platform" (not the sheet's "Finance API" one).
NOTION_TOKEN=
NOTION_TRANSACTIONS_DB=
NOTION_SUBSCRIPTIONS_DB=
NOTION_WEEKS_DB=
NOTION_WEBHOOK_TOKEN=               # optional; otherwise stored when Notion verifies the webhook

# off: no sync. pull: Notion -> Postgres only, web edits refused. full: two-way.
SYNC_MODE=pull
SYNC_INTERVAL=60s

# Finance rules. Defaults match the Finance Assistant sheet.
FINANCE_ACCOUNT=Mandiri Debit
FINANCE_ANCHOR_SUBSCRIPTION=Claude
FINANCE_WEEKLY_ALLOWANCE=250000
FINANCE_MIN_BALANCE=50000
FINANCE_EXCLUDE_MARKER=dikecualikan dari kuota
